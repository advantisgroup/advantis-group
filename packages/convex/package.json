{
  "name": "@advantis/convex",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./convex/_generated/api.d.ts",
      "import": "./convex/_generated/api.js",
      "default": "./convex/_generated/api.js"
    },
    "./api": {
      "types": "./convex/_generated/api.d.ts",
      "import": "./convex/_generated/api.js",
      "default": "./convex/_generated/api.js"
    },
    "./server": {
      "types": "./convex/_generated/server.d.ts",
      "import": "./convex/_generated/server.js",
      "default": "./convex/_generated/server.js"
    },
    "./dataModel": {
      "types": "./convex/_generated/dataModel.d.ts"
    },
    "./performance/callImport": {
      "types": "./convex/performance/lib/callImport.ts",
      "import": "./convex/performance/lib/callImport.ts",
      "default": "./convex/performance/lib/callImport.ts"
    },
    "./marketing/inquiry": {
      "types": "./convex/marketing/lib/inquiry.ts",
      "import": "./convex/marketing/lib/inquiry.ts",
      "default": "./convex/marketing/lib/inquiry.ts"
    },
    "./performance/xlsxZip": {
      "types": "./convex/performance/lib/xlsxZip.ts",
      "import": "./convex/performance/lib/xlsxZip.ts",
      "default": "./convex/performance/lib/xlsxZip.ts"
    }
  },
  "scripts": {
    "dev": "convex dev",
    "convex:deploy": "convex deploy",
    "codegen": "convex codegen",
    "test": "vitest run",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit",
    "lint": "oxlint ./convex",
    "lint:fix": "oxlint ./convex --fix",
    "format:check": "oxfmt --check ./convex",
    "format": "oxfmt --write ./convex"
  },
  "dependencies": {
    "@types/node": "^26.1.1",
    "convex": "^1.46.0",
    "convex-helpers": "~0.1.124",
    "xlsx": "^0.18.5",
    "zod": "^4.3.0"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "convex-test": "0.0.59",
    "typescript": "^5.9.3",
    "vitest": "^5.0.0"
  }
}
