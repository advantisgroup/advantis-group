{
  "name": "@advantis/convex",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./convex/_generated/api.d.ts",
      "import": "./convex/_generated/api.js",
      "default": "./convex/_generated/api.js"
    },
    "./api": {
      "types": "./convex/_generated/api.d.ts",
      "import": "./convex/_generated/api.js",
      "default": "./convex/_generated/api.js"
    },
    "./server": {
      "types": "./convex/_generated/server.d.ts",
      "import": "./convex/_generated/server.js",
      "default": "./convex/_generated/server.js"
    },
    "./dataModel": {
      "types": "./convex/_generated/dataModel.d.ts"
    },
    "./performance/callImport": {
      "types": "./convex/performance/lib/callImport.ts",
      "import": "./convex/performance/lib/callImport.ts",
      "default": "./convex/performance/lib/callImport.ts"
    },
    "./performance/xlsxZip": {
      "types": "./convex/performance/lib/xlsxZip.ts",
      "import": "./convex/performance/lib/xlsxZip.ts",
      "default": "./convex/performance/lib/xlsxZip.ts"
    }
  },
  "scripts": {
    "dev": "convex dev",
    "convex:deploy": "convex deploy",
    "codegen": "convex codegen",
    "type-check": "tsc --noEmit",
    "lint": "echo \"@advantis/convex: no lint\""
  },
  "dependencies": {
    "@types/node": "^26.1.1",
    "convex": "^1.34.0",
    "xlsx": "^0.18.5",
    "zod": "^4.3.0"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
