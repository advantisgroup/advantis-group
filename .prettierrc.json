{
    "printWidth": 80,
    "tabWidth": 2,
    "objectWrap": "preserve",
    "useTabs": false,
    "semi": true,
    "singleQuote": false,
    "quoteProps": "as-needed",
    "jsxSingleQuote": false,
    "trailingComma": "es5",
    "bracketSpacing": true,
    "bracketSameLine": false,
    "arrowParens": "avoid",
    "endOfLine": "lf",
    "embeddedLanguageFormatting": "auto",
    "overrides": [
        {
            "files": [
                "*.json",
                "*.jsonc"
            ],
            "options": {
                "printWidth": 120
            }
        },
        {
            "files": [
                "*.md",
                "*.mdx"
            ],
            "options": {
                "printWidth": 120,
                "proseWrap": "preserve"
            }
        }
    ]
}
