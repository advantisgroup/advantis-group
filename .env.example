# ─── Convex ───────────────────────────────────────────────────────────────────
CONVEX_DEPLOYMENT=
CONVEX_DEPLOY_KEY=
CONVEX_SERVER_KEY=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=
# Internal URL used by the API server to reach Convex (server-side only)
CONVEX_URL=
API_INTERNAL_URL=

# ─── Clerk (advantisgroup.de, shared across marketing + intranet) ─────────────
# One Clerk instance with advantisgroup.de as its root domain; intranet lives
# at intern.advantisgroup.de as an allowed subdomain, sharing the same auth
# session — no satellite domain needed for subdomains of the same root.
CLERK_JWT_ISSUER_DOMAIN=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# ─── API server ───────────────────────────────────────────────────────────────
SITE_URL=
INTERNAL_URL=
API_URL=
NEXT_PUBLIC_API_URL=
CORS_ORIGINS=
PORT=

# ─── Email (Resend) ───────────────────────────────────────────────────────────
RESEND_API_KEY=
INTERNAL_EMAIL_FROM=
# Svix signing secret for the Resend webhook (/webhooks/resend) that reports
# delivery/open/click events for Updates email broadcasts back into Convex.
RESEND_WEBHOOK_SECRET=

# ─── Clockodo integration ─────────────────────────────────────────────────────
CLOCKODO_API_KEY=
CLOCKODO_API_URL=
CLOCKODO_API_USER=
CLOCKODO_EXTERNAL_APP=
CLOCKODO_WEBHOOK_TOKEN=

# ─── Convex access control ────────────────────────────────────────────────────
ADMIN_EMAILS=
ALLOWED_EMAIL_DOMAINS=

# ─── Performance (multi-tenant sales KPI dashboard) ───────────────────────────
# Emails allowed to self-claim the "Advantis" company's Admin role via
# /performance/setup (Convex deployment). Comma/semicolon/whitespace list.
# Grandfathered fallback only — every other company sets its own list at
# creation time (companies.adminBootstrapEmails).
PERFORMANCE_ADMIN_EMAILS=
# Emails allowed to self-claim the cross-company isSuperAdmin login (Convex
# deployment) — the one piece of Performance config that stays global rather
# than per-company, since a super-admin isn't scoped to any single company.
PERFORMANCE_SUPER_ADMIN_EMAILS=
# Vercel API token + project (Convex deployment) — used to add each new
# company's own domain (e.g. "salespirates.de", not a subdomain of anything
# Advantis owns) to the Vercel project via the Domains API on creation. A
# token scoped to Domains management on this one project is enough;
# VERCEL_TEAM_ID is only needed if the project lives under a team account
# rather than a personal account. No wildcard/root domain of Advantis's own
# is needed — every company brings its own domain, which is why each one
# still needs one DNS record added on its own registrar before it verifies.
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=

# ─── ActivityTrack (ported workforce-activity dashboard) ──────────────────────
# Server-to-server secret guarding agent ingestion + signal pushes (set on the
# Convex deployment AND on the API service).
ACTIVITYTRACK_SIGNAL_SECRET=
# Webhook auth for the Genesys relay + legacy Clockodo adapter shapes.
ACTIVITYTRACK_WEBHOOK_SECRET=
# Genesys Cloud OAuth client (set on the Convex deployment).
GENESYS_CLIENT_ID=
GENESYS_CLIENT_SECRET=
GENESYS_REGION=
# Clockodo break service ids (comma list) — optional break-type classification.
CLOCKODO_BREAK_SERVICE_IDS=
# Device-token encryption key carried over for parity (Convex deployment).
API_TOKENS_ENCRYPTION_KEY=
# Migration only: the OLD ActivityTrack Convex deployment URL the migration
# action reads from. Removable after cutover.
ACTIVITYTRACK_OLD_CONVEX_URL=

# ─── OneDrive / Microsoft Graph ───────────────────────────────────────────────
# The drive is a PERSONAL Microsoft account (chefsache@), so this uses the
# delegated flow. Azure app registration: "Personal Microsoft accounts only",
# delegated Graph perms Files.ReadWrite.All + offline_access + User.Read, and a
# Web redirect URI http://localhost:5555/callback for the one-time bootstrap.
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
# Obtain once via `bun run onedrive:auth` (apps/api), sign in as chefsache@.
# The API rotates + persists the latest token in Convex, so this is only a seed.
ONEDRIVE_REFRESH_TOKEN=
# OAuth authority. Default "consumers" (personal accounts); "common" also works.
ONEDRIVE_AUTHORITY=
# The rotating refresh token is stored AES-256-GCM-encrypted in Convex using the
# existing WIKI_CHAT_ENC_KEY (see apps/api/.env.example) — must be set on the API.
# Advantis Group root, relative to the drive root (default "Documents/Advantis Group").
ONEDRIVE_ROOT_PATH=
# Sub-trees relative to the AG root (defaults "Team" / "Geschäftsführung").
ONEDRIVE_TEAM_PATH=
ONEDRIVE_GF_PATH=
# Change-notification webhook: a shared secret echoed as clientState, plus the
# public HTTPS URL Graph posts notifications to (…/webhooks/onedrive).
ONEDRIVE_WEBHOOK_SECRET=
ONEDRIVE_WEBHOOK_URL=

# ─── KV / Redis ───────────────────────────────────────────────────────────────
KV_URL=
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=
REDIS_URL=

# ─── Marketing public vars ────────────────────────────────────────────────────
NEXT_PUBLIC_EMAIL_ADRESS=
NEXT_PUBLIC_DOMAIN=
NEXT_PUBLIC_PHONE_NUMBER=
NEXT_PUBLIC_ADRESS=
NEXT_PUBLIC_ALLOW_SUBMISSIONS=
NEXT_PUBLIC_SUBMISSION_TEXT=
NEXT_PUBLIC_SUBMISSION_TEXT_DE=
NEXT_PUBLIC_SUBMISSION_TEXT_ZH=
NEXT_PUBLIC_SUBMISSION_TEXT_FR=
ALLOW_SUBMISSIONS=

# Consumed by apps/intranet only, to build content-proxy copy-link URLs that
# point at the marketing deployment — same value as NEXT_PUBLIC_DOMAIN above.
NEXT_PUBLIC_MARKETING_URL=

# Consumed by apps/marketing only, to link signed-in company-email users over
# to the intranet (header CTA + footer link) — same value as the intranet's
# own NEXT_PUBLIC_DOMAIN.
NEXT_PUBLIC_INTRANET_URL=

# ─── Analytics ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
