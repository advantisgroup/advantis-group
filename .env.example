# ─── Convex ───────────────────────────────────────────────────────────────────
CONVEX_DEPLOYMENT=
CONVEX_DEPLOY_KEY=
CONVEX_SERVER_KEY=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=
# Internal URL used by the API server to reach Convex (server-side only)
CONVEX_URL=
API_INTERNAL_URL=

# ─── Clerk — Marketing site (advantisgroup.de) ────────────────────────────────
CLERK_JWT_ISSUER_DOMAIN=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# ─── Clerk — Intranet (intern.advantisgroup.de) ───────────────────────────────
# Second Clerk instance; shares the same Convex deployment.
# Set INTERNAL_CLERK_JWT_ISSUER_DOMAIN in the Convex dashboard too.
INTERNAL_CLERK_JWT_ISSUER_DOMAIN=
INTERNAL_CLERK_SECRET_KEY=
INTERNAL_CLERK_PUBLISHABLE_KEY=
NEXT_PUBLIC_INTERNAL_CLERK_PUBLISHABLE_KEY=

# ─── API server ───────────────────────────────────────────────────────────────
SITE_URL=
INTERNAL_URL=
API_URL=
NEXT_PUBLIC_API_URL=
CORS_ORIGINS=
PORT=

# ─── Email (Resend) ───────────────────────────────────────────────────────────
RESEND_API_KEY=
INTERNAL_EMAIL_FROM=

# ─── Clockodo integration ─────────────────────────────────────────────────────
CLOCKODO_API_KEY=
CLOCKODO_API_URL=
CLOCKODO_API_USER=
CLOCKODO_EXTERNAL_APP=
CLOCKODO_WEBHOOK_TOKEN=

# ─── Convex access control ────────────────────────────────────────────────────
ADMIN_EMAILS=
ALLOWED_EMAIL_DOMAINS=

# ─── ActivityTrack (ported workforce-activity dashboard) ──────────────────────
# Server-to-server secret guarding agent ingestion + signal pushes (set on the
# Convex deployment AND on the API service).
ACTIVITYTRACK_SIGNAL_SECRET=
# Webhook auth for the Genesys relay + legacy Clockodo adapter shapes.
ACTIVITYTRACK_WEBHOOK_SECRET=
# Genesys Cloud OAuth client (set on the Convex deployment).
GENESYS_CLIENT_ID=
GENESYS_CLIENT_SECRET=
GENESYS_REGION=
# Clockodo break service ids (comma list) — optional break-type classification.
CLOCKODO_BREAK_SERVICE_IDS=
# Device-token encryption key carried over for parity (Convex deployment).
API_TOKENS_ENCRYPTION_KEY=
# Migration only: the OLD ActivityTrack Convex deployment URL the migration
# action reads from. Removable after cutover.
ACTIVITYTRACK_OLD_CONVEX_URL=

# ─── KV / Redis ───────────────────────────────────────────────────────────────
KV_URL=
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=
REDIS_URL=

# ─── Marketing public vars ────────────────────────────────────────────────────
NEXT_PUBLIC_EMAIL_ADRESS=
NEXT_PUBLIC_DOMAIN=
