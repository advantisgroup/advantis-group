{
  "name": "@advantis/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts"
    }
  },
  "scripts": {
    "dev": "bun --watch --verbose --no-clear-screen src/index.ts",
    "start": "bun run --no-env-file src/index.ts",
    "build": "bash ../../scripts/vercel-preview-convex-api-build.sh \"tsc --noEmit\"",
    "onedrive:auth": "bun run scripts/onedrive-auth.ts",
    "type-check": "tsc --noEmit",
    "lint": "echo \"@advantis/api: no lint\""
  },
  "dependencies": {
    "@advantis/api-contract": "workspace:*",
    "@advantis/convex": "workspace:*",
    "@anthropic-ai/sdk": "^0.106.0",
    "@clerk/backend": "^2.18.0",
    "@simplewebauthn/server": "^13.0.0",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.36.1",
    "@vercel/functions": "^3.9.7",
    "convex": "^1.34.0",
    "effect": "^3.22.1",
    "elysia": "^1.4.22",
    "file-type": "^21.0.0",
    "otpauth": "^9.5.1",
    "qrcode": "^1.5.4",
    "resend": "^6.9.1",
    "svix": "^1.42.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/qrcode": "^1.5.6",
    "typescript": "^5.9.3"
  }
}
