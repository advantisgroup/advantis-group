# --- Server ---
PORT=3002
# Comma-separated extra allowed CORS origins (in addition to the defaults)
CORS_ORIGINS=
INTERNAL_URL=http://localhost:3001
SITE_URL=http://localhost:3000

# --- Convex (shared deployment) ---
CONVEX_URL=https://wry-turtle-334.convex.cloud
# Shared secret that gates server-key Convex mutations (must match Convex env)
CONVEX_SERVER_KEY=

# --- Wiki Chat (AI assistant) ---
# Anthropic API key powering the streaming Wiki assistant
ANTHROPIC_API_KEY=
# 32-byte base64 key used to encrypt chat history at rest (AES-256-GCM).
# Generate with: openssl rand -base64 32
WIKI_CHAT_ENC_KEY=

# --- Intranet Clerk instance (secondary application) ---
INTERNAL_CLERK_SECRET_KEY=
NEXT_PUBLIC_INTERNAL_CLERK_PUBLISHABLE_KEY=
# Clerk webhook signing secret (svix) for /webhooks/clerk
CLERK_WEBHOOK_SECRET=

# --- Resend (transactional email) ---
RESEND_API_KEY=
INTERNAL_EMAIL_FROM=Advantis Intranet <noreply@intranet.advantisgroup.de>
# Resend webhook signing secret (svix) for /webhooks/resend — delivery/open/click
# tracking for Updates email broadcasts. Register the endpoint in the Resend
# dashboard (Webhooks -> Add Endpoint -> https://api.advantisgroup.de/webhooks/resend)
# subscribed to email.sent/delivered/opened/clicked/bounced/complained/delivery_delayed.
RESEND_WEBHOOK_SECRET=

# --- Upstash (rate limiting) ---
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- Clockodo (primary absence ingest) ---
CLOCKODO_API_URL=https://my.clockodo.com/api
CLOCKODO_API_USER=
CLOCKODO_API_KEY=
CLOCKODO_EXTERNAL_APP=AdvantisIntranet;it@advantisgroup.de
# Shared token configured on the Clockodo webhook for /webhooks/clockodo
CLOCKODO_WEBHOOK_TOKEN=
