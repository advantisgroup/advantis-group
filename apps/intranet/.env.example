# --- Intranet Clerk instance (secondary application) ---
# Use the INTRANET Clerk app's keys here (separate from the marketing instance).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# --- Convex (shared deployment) ---
NEXT_PUBLIC_CONVEX_URL=https://wry-turtle-334.convex.cloud

# --- Elysia API (api.advantisgroup.de) ---
# The Wiki Chat assistant + its encrypted history live behind this API.
NEXT_PUBLIC_API_URL=http://localhost:3002

# --- Company contact (Privacy Policy / Terms of Use "controller" section) ---
# Same values as the marketing site — Next.js inlines NEXT_PUBLIC_* per app,
# so this needs to be set for the intranet deployment too.
NEXT_PUBLIC_ADRESS=
NEXT_PUBLIC_EMAIL_ADRESS=

# --- Marketing site base URL (content-proxy copy-link) ---
# Same value as marketing's own NEXT_PUBLIC_DOMAIN — used to build
# cross-domain https://<marketing-domain>/content/<type>/<storageId> links
# from the file viewer's "copy link" action.
NEXT_PUBLIC_MARKETING_URL=http://localhost:3000
