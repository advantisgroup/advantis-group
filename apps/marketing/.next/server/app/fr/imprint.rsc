3:["$","$L17",null,{"formats":"$undefined","locale":"fr","messages":{"nav":{"home":"Accueil","brands":"Nos Marques","about":"À Propos","team":"Équipe","contact":"Contact","privacy":"Politique de Confidentialité","imprint":"Mentions Légales","licenses":"Licences","settings":"Paramètres","toggleMenu":"Basculer le menu","settingsMenu":{"label":"Paramètres","language":"Langue","appearance":"Apparence","light":"Clair","dark":"Sombre","system":"Système","auto":"Auto"}},"hero":{"title":"Plus qu'une entreprise, une","titleHighlight":"Puissance Commerciale","subtitle":"Nous portons vos ventes au niveau supérieur !","ctaPrimary":"Contactez-nous Maintenant","ctaSecondary":"Découvrir Nos Marques"},"features":{"badge":"Nos Forces","eyebrow":"Moteur Conseil","title":"Pourquoi","titleBrand":"Advantis Group","subtitle":"Nous combinons plus de 15 ans d'expérience avec des approches innovantes pour porter vos ventes au niveau supérieur.","feature1":{"title":"Rendre les Équipes Commerciales Performantes","description":"Grâce à des stratégies ciblées et un soutien pratique, nous aidons vos équipes à atteindre leurs objectifs et à croître durablement."},"feature2":{"title":"Rendre les Ventes Plus Intelligentes","description":"Avec des outils modernes et des méthodes éprouvées, nous optimisons vos processus de vente pour une efficacité maximale."},"feature3":{"title":"Fournir des Résultats Durables","description":"Plus de 15 ans d'expérience combinés à des approches innovantes pour un succès à long terme qui convainc."},"stats":{"experience":"Années d'Expérience","brands":"Marques","projects":"Projets Réussis","passion":"Passion"}},"brands":{"eyebrow":"Architecture de Marque","title":"Nos","titleHighlight":"Marques","subtitle":"Quatre marques fortes, un objectif commun : Votre succès commercial","salespirates":{"tagline":"Agence de Vente Externe","description":"Nous fournissons des leads ou soutenons vos ventes avec des résultats mesurables. Actif, ciblé et efficace."},"rodeo":{"tagline":"Conseil Stratégique","description":"La vente, c'est le Far West. Nous réalignons vos ventes, les rendons évolutives et conduisons à la croissance avec efficacité."},"oldschool":{"tagline":"Formations Authentiques","description":"Coaching commercial qui fait vraiment la différence. L'expérience, l'empathie et la pratique réelle rencontrent des méthodes d'apprentissage modernes."},"salesai":{"tagline":"IA pour les Ventes","description":"Nous montrons quels outils d'IA ont vraiment du sens pour les ventes et comment rendre vos ventes plus intelligentes."},"cta":"Découvrir Toutes les Marques"},"cta":{"title":"Prêt pour le prochain","titleHighlight":"Niveau ?","subtitle":"Découvrons ensemble comment nous pouvons transformer vos ventes.","primary":"Contactez-nous Maintenant","secondary":"Envoyer un E-mail","benefits":"Consultation Initiale Gratuite • Sans Engagement • Solutions Individuelles"},"footer":{"description":"Nous sommes votre partenaire pour des ventes réussies. Avec plus de 15 ans d'expérience et quatre marques fortes, nous faisons avancer votre entreprise.","quickLinks":"Liens Rapides","ourBrands":"Nos Marques","contact":"Contact","email":"E-mail","phone":"Téléphone","address":"Adresse","legal":"Mentions Légales","followUs":"Suivez-nous","copyright":"Tous droits réservés."},"contact":{"title":"Contact","subtitle":"Travaillons ensemble sur votre succès commercial","email":"E-mail","phone":"Téléphone","address":"Adresse","tabs":{"writeMessage":"Écrire un message","requestCallback":"Demander un rappel","otherInquiries":"Autre demande","writeMessageShort":"Message","requestCallbackShort":"Rappel","otherInquiriesShort":"Demande"},"form":{"company":"Votre nom d'entreprise","firstName":"Prénom","lastName":"Nom","email":"E-mail","phone":"Téléphone","message":"Message","submit":"Envoyer","callbackRequest":"Demander un rappel","phonePlaceholder":"+33 1 23 45 67 89","desiredTime":"Quand pouvons-nous vous joindre ?","notes":"Remarques (optionnel)","notesPlaceholder":"De quoi s'agit-il ?","callbackEmailNote":"Pour la confirmation de votre rappel","callbackTimeNote":"Nous vous appellerons à l'heure souhaitée","privacyPrefix":"En soumettant ce formulaire, vous acceptez que","privacySuffix":"utilise les données fournies pour traiter votre demande. Vos données ne seront stockées que pour répondre à votre demande et ne seront pas transmises à des tiers.","privacySuffixCallback":"utilise les données fournies pour organiser le rappel.","privacyLink":"Plus d'informations dans notre politique de confidentialité.","privacyNoteLabel":"AVIS DE CONFIDENTIALITÉ :"},"sidebar":{"title":"Pourquoi","description1":"Que vous recherchiez un soutien dans la vente active, des conseils stratégiques ou la sélection de solutions d'IA modernes, nous vous aidons !","descriptionMessage":"Contactez-nous pour une consultation sans engagement et travaillons ensemble sur votre succès commercial.","descriptionCallback":"Planifiez un rappel et nous discuterons ensemble de la manière dont nous pouvons faire avancer vos ventes.","descriptionOther":"Utilisez ce formulaire pour les demandes générales, les questions sur vos droits ou d'autres sujets.","closingMessage":"Nous attendons votre demande avec impatience !","closingCallback":"Nous attendons votre appel avec impatience !","closingOther":"Nous répondrons à votre demande dans les plus brefs délais !"},"messages":{"writeUs":"Écrivez-nous","writeUsDesc":"Envoyez-nous un message et nous vous répondrons dans les 24 heures","callback":"Planifier un rappel","callbackDesc":"Dites-nous quand nous pouvons vous joindre le mieux","otherInquiry":"Autre demande","otherInquiryDesc":"Avez-vous des questions ou des demandes générales ? Nous sommes là pour vous aider !","successTitle":"Envoyé !","successDesc":"Nous vous répondrons dans les 24 heures.","callSuccessTitle":"Rappel demandé !","callSuccessDesc":"Nous vous appellerons à l'heure souhaitée.","errorTitle":"Une erreur s'est produite","errorDesc":"Veuillez vérifier vos saisies"},"submissionBanner":{"title":"Formulaires temporairement indisponibles","defaultMessage":"Les formulaires de contact ne sont pas traités pour le moment.","notifyCta":"M'avertir quand les formulaires reviennent","dismiss":"Fermer l'avertissement"},"notify":{"close":"Fermer","cancel":"Annuler","emailLabel":"Adresse e-mail","emailPlaceholder":"vous@example.com","switchToRemove":"Retirer l'e-mail de la liste","switchToSubscribe":"← Retour aux notifications","tabs":{"subscribe":"S'abonner","remove":"Se désabonner"},"errors":{"generic":"Une erreur s'est produite. Veuillez réessayer.","network":"Erreur réseau. Vérifiez votre connexion puis réessayez.","invalidEmail":"Saisissez une adresse e-mail valide."},"subscribe":{"title":"Restez informé","description":"Saisissez votre e-mail et nous vous informerons dès que nos formulaires de contact seront à nouveau disponibles.","cta":"M'avertir","loading":"Enregistrement…"},"remove":{"title":"Supprimer votre e-mail","description":"Saisissez l'adresse e-mail que vous souhaitez retirer de notre liste de notification.","cta":"Supprimer","loading":"Suppression…"},"success":{"title":"Vous êtes sur la liste !","description":"Nous vous enverrons une notification dès que les formulaires de contact seront à nouveau disponibles."},"duplicate":{"title":"Vous êtes déjà sur la liste !","description":"Nous avons déjà votre e-mail. Nous vous contacterons dès que les formulaires seront à nouveau disponibles."},"removed":{"title":"E-mail supprimé","description":"Votre e-mail a été retiré de notre liste de notification. Vous ne recevrez plus d'autres mises à jour."}},"otherForm":{"topic":"Sujet","selectTopic":"Veuillez sélectionner un sujet","topics":{"withdrawal":"Droit de rétractation","question":"Question","legal":"Juridique"},"subject":"Objet","subjectPlaceholder":"Entrez un objet spécifique","optional":"optionnel"},"accountHelper":{"badge":"Raccourci connecté","title":"Utilisez les informations de votre compte actuel","description":"Si vous nous contactez avec votre compte Clerk actuel, nous pouvons préremplir votre nom et votre e-mail pour aller plus vite.","signedInAs":"Connecté en tant que {email}","emailNote":"Vous pouvez tout de même remplacer l’e-mail du formulaire par une adresse d’entreprise si c’est mieux pour le suivi. Nous garderons les deux pour plus de clarté.","useAccount":"Utiliser les infos de mon compte","useAccountSuccess":"Ajouté au formulaire","signedOutTitle":"Envoyer vos formulaires plus vite ?","signedOutDescription":"Connectez-vous d’abord pour préremplir automatiquement vos coordonnées et retrouver toutes vos demandes envoyées dans votre compte.","signInCta":"Se connecter pour préremplir","storedAccountNote":"Lorsque vous envoyez une demande en étant connecté, nous enregistrons à la fois votre compte connecté et l’e-mail saisi dans le formulaire pour éviter toute ambiguïté.","successNotice":"Vos informations de compte figurent maintenant dans le formulaire ci-dessous.","scrollNotice":"Vos informations de compte ont été ajoutées au formulaire ci-dessous."}},"about":{"hero":{"badge":"À Propos","titlePart1":"Votre maison pour","titlePart2":"l'excellence commerciale","subtitle":"<brand>Advantis Group GmbH</brand> réunit plus de 15 ans d'expérience commerciale sous un même toit – avec passion, pragmatisme et une focalisation claire sur le succès."},"mission":{"badge":"Mission","title":"La vente comme artisanat et attitude","description":"Nous comprenons la vente non pas comme un hasard, mais comme un artisanat. Notre ambition : des solutions durables, efficaces et pratiques qui fonctionnent."},"vision":{"badge":"Vision","title":"Familial, professionnel, honnête","description":"Nous sommes familiers dans nos échanges, professionnels dans la mise en œuvre et honnêtes dans les résultats – pour des partenariats à long terme qui créent la confiance."},"story":{"badge":"Notre Histoire","text1":"<brand>Advantis Group GmbH</brand> a été fondée en 2025 par <founder>Andrea Reichl</founder> et réunit plus de 15 ans d'expérience commerciale dans divers secteurs sous un même toit.","text2":"Ce qui a commencé il y a des années comme une entreprise individuelle est maintenant un groupe d'entreprises avec des marques fortes et un objectif commun : 100 % Sales.","text3":"Nous n'aimons pas le superflu – nous n'avons pas réinventé la roue, juste mis de belles jantes. Pragmatique, efficace, durable."},"stats":{"experience":"Années d'Expérience","projects":"Projets Réussis","brands":"Marques Fortes"},"values":{"badge":"Nos Valeurs","experienceTitle":"Expérience","experienceDesc":"Plus de 15 ans d'expérience commerciale dans divers secteurs","innovationTitle":"Innovation","innovationDesc":"Outils modernes et méthodes éprouvées pour une efficacité maximale","passionTitle":"Passion","passionDesc":"Résultats durables grâce à l'engagement et à l'expertise"},"cta":{"title":"Prêt pour la prochaine étape ?","description":"Laissez-nous travailler ensemble sur votre succès commercial. Que ce soit pour un soutien dans la vente active, des conseils stratégiques ou des solutions d'IA modernes – nous vous aidons.","button":"Contactez-nous"}},"team":{"hero":{"badge":"L'Équipe","titlePart1":"Les visages derrière","subtitle":"Experts, visionnaires et faiseurs. Unis par la passion de l'excellence commerciale."},"founder":{"role":"PDG / Directrice Générale","badge":"Leadership","quote":"« La vente n'est pas seulement un travail, c'est une attitude. »","bio":"Passionnée de vente, stratège et faiseuse. Avec plus de 15 ans d'expérience dans la vente, le coaching et la création d'entreprise, Andrea dirige le groupe advantis avec passion, pragmatisme et un accent clair sur le succès et l'humain.","contactBtn":"Contacter"},"roles":{"inbound":"Chef d'équipe Inbound Sales","outbound":"Chef d'équipe Outbound Sales","it":"Chef de projet IT","hr":"Spécialiste RH","marketing":"Responsable Marketing en ligne","coach":"Coach et Formatrice","quality":"Délégué à la protection des données et responsable qualité"},"grid":{"title":"Notre Équipe","subtitle":"Les experts à vos côtés","cardFooter":"Équipe Advantis"}},"brandsPage":{"hero":{"badge":"Quatre marques premium – Un objectif","titlePrefix":"Nos","titleSuffix":"Marques","subtitle":"Des solutions de vente sur mesure pour un succès durable","scroll":"Découvrez nos marques"},"items":{"salespirates":{"tagline":"Votre agence commerciale externe","description":"Votre agence commerciale externe pour les ventes Inbound ou Outbound. Nous fournissons des leads ou soutenons vos ventes – activement, de manière ciblée et avec des résultats mesurables.","highlights":{"0":"Génération & Qualification de leads","1":"Ventes Inbound & Outbound","2":"Performance mesurable"}},"rodeo":{"tagline":"Conseil stratégique en vente","description":"La vente c'est le Far West et avec Rodeo, on s'y connaît ! Nous vous fournissons un conseil stratégique en vente qui réoriente vos ventes, les rend absolument évolutives et mène à la croissance avec efficacité.","highlights":{"0":"Réorientation stratégique","1":"Processus évolutifs","2":"Axé sur la croissance"}},"oldschool":{"tagline":"Formations commerciales authentiques","description":"Le monde n'a pas besoin de nouveaux gadgets commerciaux. Nous portons vos équipes de vente au maximum avec des coachings commerciaux authentiques ! Le mot magique ici est durabilité. Vous pouvez réserver 1000 coachings commerciaux sans jamais réussir dans les affaires quotidiennes – nous avons la formation qui vous fait vraiment avancer, vous et votre équipe. Expérience, empathie et pratique réelle rencontrent chez nous des méthodes d'apprentissage modernes.","highlights":{"0":"Formations durables","1":"Axé sur la pratique","2":"Méthodes d'apprentissage modernes"}},"salesai":{"tagline":"IA pour une vente intelligente","description":"Tout le monde parle d'outils d'IA. Nous vous conseillons sur les outils d'IA qui ont actuellement du sens pour les équipes de vente et apportent une réelle valeur ajoutée. Nous vous montrons comment la technologie IA rend votre vente réellement plus intelligente.","highlights":{"0":"Conseil en outils IA","1":"Intégration pratique","2":"Valeur ajoutée réelle"}}},"cta":{"titlePart1":"Quelle marque","titlePart2":"vous correspond ?","description":"Découvrons ensemble comment nous pouvons faire passer vos ventes au niveau supérieur.","button":"Contactez-nous maintenant"},"learnMore":"En savoir plus"},"privacy":{"title":"Politique de Confidentialité","subtitle":"Informations sur le traitement de vos données conformément au RGPD","tableOfContents":"Table des Matières","sections":{"overview":{"title":"Confidentialité en un Coup d'Œil","content":"Les informations suivantes fournissent un aperçu simple de ce qui arrive à vos données personnelles lorsque vous visitez ce site Web. Les données personnelles sont toutes les données qui peuvent être utilisées pour vous identifier personnellement."},"general":{"title":"Informations Générales","content1":"Les opérateurs de ces pages prennent très au sérieux la protection de vos données personnelles. Nous traitons vos données personnelles de manière confidentielle et conformément aux réglementations légales en matière de protection des données ainsi qu'à cette politique de confidentialité.","content2":"Lorsque vous utilisez ce site Web, diverses données personnelles sont collectées. Cette politique de confidentialité explique quelles données nous collectons et à quoi nous les utilisons."},"responsible":{"title":"Partie Responsable","intro":"La partie responsable du traitement des données sur ce site Web est :"},"collection":{"title":"Collecte de Données","subtitle":"Quelles données collectons-nous ?","intro":"Lors de la visite de ce site Web, le serveur enregistre automatiquement les informations que votre navigateur transmet. Cela inclut :","items":{"ip":"Adresse IP","browser":"Type et version du navigateur","os":"Système d'exploitation utilisé","datetime":"Date et heure d'accès","referrer":"Sites Web à partir desquels le système de l'utilisateur a accédé à notre site Web"},"footer":"Ces données sont utilisées exclusivement pour assurer le fonctionnement et pour améliorer le service. Elles ne sont pas fusionnées avec d'autres sources de données."},"contact":{"title":"Formulaire de Contact","content1":"Si vous nous envoyez des demandes par e-mail ou formulaire de contact, vos informations du formulaire de demande, y compris les coordonnées que vous avez fournies, seront stockées dans le but de traiter la demande et en cas de questions de suivi.","content2":"Nous ne partageons pas ces données sans votre consentement. Le traitement est basé sur l'Art. 6 para. 1 lit. b RGPD, si votre demande est liée à l'exécution d'un contrat ou est nécessaire pour la mise en œuvre de mesures précontractuelles."},"rights":{"title":"Vos Droits","intro":"Vous avez le droit à tout moment à une information gratuite sur vos données personnelles stockées, leur origine et leurs destinataires, et l'objectif du traitement des données, ainsi que le droit de corriger ou de supprimer ces données.","subtitle":"Vos droits en un coup d'œil :","items":{"access":{"title":"Droit d'accès :","description":"Vous pouvez demander des informations sur vos données stockées"},"rectification":{"title":"Droit de rectification :","description":"Vous pouvez demander la correction de données inexactes"},"deletion":{"title":"Droit à l'effacement :","description":"Vous pouvez demander la suppression de vos données"},"restriction":{"title":"Droit à la limitation du traitement :","description":"Vous pouvez demander la limitation du traitement"},"objection":{"title":"Droit d'opposition :","description":"Vous pouvez vous opposer au traitement"},"portability":{"title":"Droit à la portabilité des données :","description":"Vous pouvez recevoir vos données dans un format structuré"}},"footer":"Pour cela et d'autres questions sur le sujet des données personnelles, vous pouvez toujours nous contacter à l'adresse indiquée dans les mentions légales."}}},"imprint":{"title":"Mentions Légales","sections":{"company":{"title":"Informations selon § 5 TMG","country":"Allemagne"},"contact":{"title":"Contact","email":"E-mail :","phone":"Téléphone :","phonePlaceholder":"[à suivre]"},"taxId":{"title":"Numéro de TVA","content":"Numéro d'identification TVA selon § 27 a de la loi sur la taxe sur la valeur ajoutée : [à suivre]"},"register":{"title":"Inscription au Registre du Commerce","intro":"Inscription au registre du commerce.","court":"Tribunal d'enregistrement :","number":"Numéro d'enregistrement :"},"responsible":{"title":"Responsable du contenu selon § 55 para. 2 RStV :"}}},"email":{"greeting":"Bonjour {firstName} {lastName},","bodyIntro":"merci pour votre message. Ceci est une copie de la demande que nous venons de recevoir.","bodyOutro":"Nous examinons votre demande et vous répondrons dès que possible – généralement dans les prochaines 24 heures.","yourMessage":"Votre message :","poweredBy":"Propulsé par","rightsReserved":"Tous droits réservés.","subject":"Objet","topic":"Sujet","confirmationTitle":"Nous avons reçu votre demande","confirmationBody":"Merci pour votre message. Nous avons enregistré votre demande et vous répondrons dans les plus brefs délais.","submissionType":"Type de demande","contactEmail":"E-mail","contactPhone":"Téléphone","company":"Entreprise","typeMessage":"Message","typeCallback":"Rappel","typeOther":"Autre"},"auth":{"badge":"Accès sécurisé","menuLabel":"Compte","guest":"Invité","providerHint":"Continuez avec Google ou utilisez votre e-mail pour créer un compte.","signInPageCta":"Ouvrir la connexion","signUpPageCta":"Ouvrir l’inscription","signIn":"Se connecter","signUp":"Créer un compte","signedIn":"Connecté avec Clerk","accountCta":"Gérer le compte","signOut":"Se déconnecter","signInTitle":"Bon retour chez Advantis Group","signInSubtitle":"Connectez-vous avec Clerk pour gérer votre profil, vos paramètres de sécurité et les futures expériences protégées depuis un seul endroit.","signUpTitle":"Créez votre compte Advantis","signUpSubtitle":"Utilisez Clerk pour créer un compte sécurisé et gérer votre profil, vos méthodes de connexion et les futures expériences réservées aux membres.","accountBadge":"Centre de compte","accountTitle":"Votre compte","accountSubtitle":"Gérez votre profil, vos paramètres de sécurité et vos sessions actives dans le centre de compte hébergé de Clerk.","signInRequired":"Veuillez vous connecter pour accéder à vos paramètres de compte.","submissionsCta":"Voir les demandes","contactCta":"Envoyer une nouvelle demande","submissions":{"badge":"Historique des demandes","title":"Vos demandes","subtitle":"Consultez les formulaires de contact envoyés pendant votre session et voyez quelle adresse e-mail et quelles informations d’entreprise vous avez partagées.","newSubmissionCta":"Envoyer une autre demande","accountCta":"Gérer le compte","loading":"Chargement de vos demandes…","errorTitle":"Impossible de charger vos demandes.","errorDescription":"Veuillez réessayer dans un instant.","emptyTitle":"Aucune demande pour le moment","emptyDescription":"Dès que vous envoyez un formulaire de contact en étant connecté, il apparaîtra ici avec son statut et les détails transmis.","contactEmail":"E-mail de contact utilisé","accountEmail":"Compte connecté","company":"Entreprise","desiredTime":"Heure de rappel souhaitée","message":"Message","topic":"Sujet","notes":"Notes","deliveryIssue":"Problème d’envoi","types":{"message":"Message","callback":"Rappel","other":"Autre demande"},"status":{"sent":"Envoyé","failed":"À vérifier"}}}},"now":"$undefined","timeZone":"Europe/Berlin","children":["$L18","$L19","$L1a"]}]
