{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/[locale]/layout,_N_T_/[locale]/(pages)/layout,_N_T_/[locale]/(pages)/brands/layout,_N_T_/[locale]/(pages)/brands/page,_N_T_/de/brands"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/$d$locale/!KHBhZ2VzKQ/brands/__PAGE__",
    "/$d$locale/!KHBhZ2VzKQ/brands",
    "/$d$locale/!KHBhZ2VzKQ",
    "/$d$locale",
    "/_index",
    "/_head"
  ]
}