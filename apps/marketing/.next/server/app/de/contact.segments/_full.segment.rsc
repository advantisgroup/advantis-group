3:["$","$L17",null,{"formats":"$undefined","locale":"de","messages":{"nav":{"home":"Startseite","brands":"Unsere Marken","about":"Über Uns","team":"Team","contact":"Kontakt","privacy":"Datenschutz","imprint":"Impressum","licenses":"Lizenzen","settings":"Einstellungen","toggleMenu":"Menü umschalten","settingsMenu":{"label":"Einstellungen","language":"Sprache","appearance":"Darstellung","light":"Hell","dark":"Dunkel","system":"System","auto":"Automatisch"}},"hero":{"title":"Mehr als ein Unternehmen, komplette","titleHighlight":"Sales Power","subtitle":"Wir bringen Ihren Vertrieb auf das nächste Level!","ctaPrimary":"Jetzt Kontakt aufnehmen","ctaSecondary":"Unsere Marken entdecken"},"features":{"badge":"Unsere Stärken","eyebrow":"Beratungs-Engine","title":"Warum","titleBrand":"Advantis Group","subtitle":"Wir kombinieren über 15 Jahre Erfahrung mit innovativen Ansätzen, um Ihren Vertrieb auf das nächste Level zu bringen.","feature1":{"title":"Sales-Teams erfolgreich machen","description":"Durch gezielte Strategien und praxisnahe Unterstützung helfen wir Ihren Teams, ihre Ziele zu erreichen und nachhaltig zu wachsen."},"feature2":{"title":"Vertrieb smarter gestalten","description":"Mit modernen Tools und bewährten Methoden optimieren wir Ihre Vertriebsprozesse für maximale Effizienz."},"feature3":{"title":"Nachhaltige Ergebnisse liefern","description":"Über 15 Jahre Erfahrung gepaart mit innovativen Ansätzen für langfristigen Erfolg, der überzeugt."},"stats":{"experience":"Jahre Erfahrung","brands":"Marken","projects":"Erfolgreiche Projekte","passion":"Leidenschaft"}},"brands":{"eyebrow":"Markenarchitektur","title":"Unsere","titleHighlight":"Marken","subtitle":"Vier starke Marken, ein gemeinsames Ziel: Ihr Vertriebserfolg","salespirates":{"tagline":"Externe Vertriebsagentur","description":"Wir liefern Leads oder unterstützen Ihren Vertrieb mit messbaren Ergebnissen. Aktiv, zielgerichtet und effektiv."},"rodeo":{"tagline":"Strategische Beratung","description":"Sales ist Wild West. Wir richten Ihren Vertrieb neu aus, machen ihn skalierbar und führen mit Effizienz zum Wachstum."},"oldschool":{"tagline":"Authentische Trainings","description":"Sales-Coachings die wirklich weiterbringen. Erfahrung, Empathie und echte Praxis treffen auf moderne Lernmethoden."},"salesai":{"tagline":"KI für den Vertrieb","description":"Wir zeigen, welche KI-Tools für Sales wirklich Sinn machen und wie Sie Ihren Vertrieb smarter gestalten."},"cta":"Alle Marken entdecken"},"cta":{"title":"Bereit für das nächste","titleHighlight":"Level?","subtitle":"Lassen Sie uns gemeinsam herausfinden, wie wir Ihren Vertrieb transformieren können.","primary":"Jetzt Kontakt aufnehmen","secondary":"E-Mail schreiben","benefits":"Kostenlose Erstberatung • Keine Verpflichtungen • Individuelle Lösungen"},"footer":{"description":"Wir sind Ihr Partner für erfolgreichen Vertrieb. Mit über 15 Jahren Erfahrung und vier starken Marken bringen wir Ihr Unternehmen voran.","quickLinks":"Quick Links","ourBrands":"Unsere Marken","contact":"Kontakt","email":"E-Mail","phone":"Telefon","address":"Adresse","legal":"Rechtliches","followUs":"Folgen Sie uns","copyright":"Alle Rechte vorbehalten."},"contact":{"title":"Kontakt","subtitle":"Lassen Sie uns gemeinsam an Ihrem Vertriebserfolg arbeiten","email":"E-Mail","phone":"Telefon","address":"Adresse","tabs":{"writeMessage":"Nachricht schreiben","requestCallback":"Rückruf vereinbaren","otherInquiries":"Andere Anfrage","writeMessageShort":"Nachricht","requestCallbackShort":"Rückruf","otherInquiriesShort":"Anfrage"},"form":{"company":"Ihr Firmenname","firstName":"Vorname","lastName":"Nachname","email":"E-Mail","phone":"Telefon","message":"Nachricht","submit":"Absenden","callbackRequest":"Rückruf anfordern","phonePlaceholder":"+49 123 456789","desiredTime":"Wann können wir Sie erreichen?","notes":"Anmerkungen (optional)","notesPlaceholder":"Worum geht es in dem Gespräch?","callbackEmailNote":"Für die Bestätigung Ihres Rückrufs","callbackTimeNote":"Wir rufen Sie zum gewünschten Zeitpunkt an","privacyPrefix":"Mit dem Absenden des Formulars erklären Sie sich damit einverstanden, dass die","privacySuffix":"Ihre angegebenen Daten zum Zweck der Bearbeitung Ihrer Anfrage verwendet. Ihre Daten werden ausschließlich zur Beantwortung Ihrer Anfrage gespeichert und nicht an Dritte weitergegeben.","privacySuffixCallback":"Ihre angegebenen Daten zum Zweck der Rückrufvereinbarung verwendet.","privacyLink":"Weitere Informationen finden Sie in unserer Datenschutzerklärung.","privacyNoteLabel":"HINWEIS AUF DATENSCHUTZ:"},"sidebar":{"title":"Warum","description1":"Ob Sie Unterstützung im aktiven Vertrieb, in der strategischen Beratung oder bei der Auswahl moderner KI-Lösungen suchen – wir helfen Ihnen dabei!","descriptionMessage":"Kontaktieren Sie uns für ein unverbindliches Beratungsgespräch und lassen Sie uns gemeinsam an Ihrem Vertriebserfolg arbeiten.","descriptionCallback":"Vereinbaren Sie einen Rückruf und wir besprechen gemeinsam, wie wir Ihren Vertrieb voranbringen können.","descriptionOther":"Nutzen Sie dieses Formular für allgemeine Anfragen, Fragen zu Ihren Rechten oder andere Anliegen.","closingMessage":"Wir freuen uns auf Ihre Anfrage!","closingCallback":"Wir freuen uns auf Ihren Anruf!","closingOther":"Wir beantworten Ihre Anfrage schnellstmöglich!"},"messages":{"writeUs":"Schreiben Sie uns","writeUsDesc":"Senden Sie uns eine Nachricht und wir melden uns innerhalb von 24 Stunden","callback":"Rückruf vereinbaren","callbackDesc":"Teilen Sie uns mit, wann wir Sie am besten erreichen können","otherInquiry":"Andere Anfrage","otherInquiryDesc":"Haben Sie Fragen oder allgemeine Anliegen? Wir helfen Ihnen gerne!","successTitle":"Gesendet!","successDesc":"Wir werden uns in bis zu 24h bei ihnen melden.","callSuccessTitle":"Rückruf angefordert!","callSuccessDesc":"Wir rufen Sie zum gewünschten Zeitpunkt an.","errorTitle":"Etwas ist schiefgelaufen","errorDesc":"Bitte überprüfen Sie Ihre Eingaben"},"submissionBanner":{"title":"Formulare vorübergehend nicht verfügbar","defaultMessage":"Kontaktformulare werden derzeit nicht verarbeitet.","notifyCta":"Benachrichtigen, wenn Formulare wieder live sind","dismiss":"Hinweis schließen"},"notify":{"close":"Schließen","cancel":"Abbrechen","emailLabel":"E-Mail-Adresse","emailPlaceholder":"du@example.com","switchToRemove":"E-Mail aus Liste entfernen","switchToSubscribe":"← Zurück zu Benachrichtigungen","tabs":{"subscribe":"Abonnieren","remove":"Abbestellen"},"errors":{"generic":"Etwas ist schiefgelaufen. Bitte versuchen Sie es erneut.","network":"Netzwerkfehler. Bitte überprüfen Sie Ihre Verbindung und versuchen Sie es erneut.","invalidEmail":"Bitte eine gültige E-Mail-Adresse eingeben."},"subscribe":{"title":"Bleiben Sie auf dem Laufenden","description":"Tragen Sie Ihre E-Mail ein und wir benachrichtigen Sie, sobald unsere Kontaktformulare wieder online sind.","cta":"Benachrichtigen","loading":"Speichern…"},"remove":{"title":"E-Mail entfernen","description":"Geben Sie die E-Mail-Adresse ein, die aus unserer Benachrichtigungsliste entfernt werden soll.","cta":"Entfernen","loading":"Entfernen…"},"success":{"title":"Sie stehen auf der Liste!","description":"Wir senden Ihnen eine Benachrichtigung, sobald die Kontaktformulare wieder live sind."},"duplicate":{"title":"Sie stehen bereits auf der Liste!","description":"Ihre E-Mail-Adresse ist bereits hinterlegt. Wir melden uns, sobald die Formulare wieder live sind."},"removed":{"title":"E-Mail entfernt","description":"Ihre E-Mail-Adresse wurde aus unserer Benachrichtigungsliste entfernt. Sie erhalten keine weiteren Updates."}},"otherForm":{"topic":"Thema","selectTopic":"Bitte wählen Sie ein Thema","topics":{"withdrawal":"Widerrufsrecht","question":"Frage","legal":"Rechtliches"},"subject":"Betreff","subjectPlaceholder":"Geben Sie einen spezifischen Betreff ein","optional":"optional"},"accountHelper":{"badge":"Konto-Shortcut","title":"Nutze deine aktuellen Kontodaten","description":"Wenn du uns über dein aktuelles Clerk-Konto kontaktierst, können wir deinen Namen und deine E-Mail-Adresse vorausfüllen, damit die Anfrage schneller rausgeht.","signedInAs":"Angemeldet als {email}","emailNote":"Du kannst die Formular-E-Mail trotzdem durch eine Firmenadresse ersetzen, wenn sie besser für die Rückmeldung ist. Zur Klarheit speichern wir beide.","useAccount":"Meine Kontodaten verwenden","useAccountSuccess":"In das Formular übernommen","signedOutTitle":"Kontaktformulare schneller ausfüllen?","signedOutDescription":"Melde dich zuerst an. Dann füllen wir deine Kontaktdaten automatisch voraus und halten deine gesendeten Anfragen im Konto zusammen.","signInCta":"Zum Vorausfüllen anmelden","storedAccountNote":"Wenn du angemeldet sendest, speichern wir sowohl dein eingeloggtes Konto als auch die im Formular eingetragene Kontakt-E-Mail für eine klare Zuordnung.","successNotice":"Deine angemeldeten Daten stehen jetzt im Formular unten.","scrollNotice":"Deine angemeldeten Daten wurden unten ins Formular übernommen."}},"about":{"hero":{"badge":"Über uns","titlePart1":"Ihre Heimat für","titlePart2":"exzellenten Vertrieb","subtitle":"Die <brand>Advantis Group GmbH</brand> vereint über 15 Jahre Vertriebserfahrung unter einem Dach – mit Leidenschaft, Pragmatismus und einem klaren Fokus auf Erfolg."},"mission":{"badge":"Mission","title":"Vertrieb als Handwerk und Haltung","description":"Wir verstehen Vertrieb nicht als Zufall, sondern als Handwerk. Unser Anspruch: nachhaltige, effektive und praxisnahe Lösungen, die funktionieren."},"vision":{"badge":"Vision","title":"Familiär, professionell, ehrlich","description":"Dabei sind wir familiär im Umgang, professionell in der Umsetzung und ehrlich im Ergebnis – für langfristige Partnerschaften, die Vertrauen schaffen."},"story":{"badge":"Unsere Geschichte","text1":"Die <brand>Advantis Group GmbH</brand> wurde 2025 von <founder>Andrea Reichl</founder> gegründet und vereint über 15 Jahre Vertriebserfahrung in unterschiedlichen Branchen unter einem Dach.","text2":"Was vor Jahren als Einzelunternehmen begann, ist nun eine Unternehmensgruppe mit starken Marken und einem gemeinsamen Focus: 100 % Sales.","text3":"Schnick-schnack liegt uns nicht – wir haben das Rad nicht neu erfunden, nur ein paar schicke Felgen aufgezogen. Pragmatisch, effektiv, nachhaltig."},"stats":{"experience":"Jahre Erfahrung","projects":"Erfolgreiche Projekte","brands":"Starke Marken"},"values":{"badge":"Unsere Werte","experienceTitle":"Erfahrung","experienceDesc":"Über 15 Jahre Vertriebserfahrung in unterschiedlichen Branchen","innovationTitle":"Innovation","innovationDesc":"Moderne Tools und bewährte Methoden für maximale Effizienz","passionTitle":"Leidenschaft","passionDesc":"Nachhaltige Ergebnisse durch Engagement und Expertise"},"cta":{"title":"Bereit für den nächsten Schritt?","description":"Lassen Sie uns gemeinsam an Ihrem Vertriebserfolg arbeiten. Ob Unterstützung im aktiven Vertrieb, strategische Beratung oder moderne KI-Lösungen – wir helfen Ihnen dabei.","button":"Kontakt aufnehmen"}},"team":{"hero":{"badge":"Das Team","titlePart1":"Die Gesichter hinter","subtitle":"Experten, Visionäre und Macher. Vereint durch die Leidenschaft für exzellenten Vertrieb."},"founder":{"role":"Geschäftsführerin","badge":"Leadership","quote":"\"Sales ist nicht nur ein Job, es ist eine Haltung.\"","bio":"Sales-Enthusiastin, Strategin und Macherin. Mit über 15 Jahren Erfahrung im Vertrieb, Coaching und Unternehmensaufbau führt Andrea die Advantis Group mit Leidenschaft, Pragmatismus und einem klaren Fokus auf Erfolg und Menschlichkeit.","contactBtn":"Kontaktieren"},"roles":{"inbound":"Teamlead Inbound Sales","outbound":"Teamlead Outbound Sales","it":"IT Projektleiter","hr":"HR Specialist","marketing":"Online Marketing Manager","coach":"Coach und Trainerin","quality":"Datenschutzbeauftragter und Qualitätsmanager"},"grid":{"title":"Unser Team","subtitle":"Die Experten an Ihrer Seite","cardFooter":"Advantis Team"}},"brandsPage":{"hero":{"badge":"Vier Premium Marken – Ein Ziel","titlePrefix":"Unsere","titleSuffix":"Marken","subtitle":"Maßgeschneiderte Sales-Lösungen für nachhaltigen Erfolg","scroll":"Entdecken Sie unsere Marken"},"items":{"salespirates":{"tagline":"Ihre externe Vertriebsagentur","description":"Ihre externe Vertriebsagentur für den Inbound- oder Outboundsales. Wir liefern Leads oder unterstützen Ihren Vertrieb – aktiv, zielgerichtet und mit messbaren Ergebnissen.","highlights":{"0":"Lead-Generierung & Qualifizierung","1":"Inbound & Outbound Sales","2":"Messbare Performance"}},"rodeo":{"tagline":"Strategische Sales-Beratung","description":"Sales ist Wild West und mit Rodeo kennen wir uns aus! Wir liefern Ihnen eine strategische Sales-Beratung, die Ihren Vertrieb neu ausrichtet, absolut skalierbar macht und mit Effizienz zum Wachstum führt.","highlights":{"0":"Strategische Neuausrichtung","1":"Skalierbare Prozesse","2":"Wachstumsorientiert"}},"oldschool":{"tagline":"Authentische Sales-Trainings","description":"Die Welt braucht keinen neuen Sales Schnick-Schnack. Wir bringen Ihre Sales Teams mit authentischen Sales-Coachings to the Max! Das Zauberwort hier ist Nachhaltigkeit. Sie können 1000 Sales Coachings buchen, ohne im daily Business jemals erfolgreich damit zu sein – wir haben das eine Training, dass Sie und Ihr Team wirklich weiterbringt. Erfahrung, Empathie und echte Praxis treffen bei uns auf moderne Lernmethoden.","highlights":{"0":"Nachhaltige Trainings","1":"Praxisorientiert","2":"Moderne Lernmethoden"}},"salesai":{"tagline":"KI für intelligenten Vertrieb","description":"Alle sprechen über KI Tools. Wir beraten Sie, welche KI-Tools für Sales-Teams aktuell Sinn machen und einen echten Mehrwert bringen. Wir zeigen Ihnen, wie KI Technologie Ihren Vertrieb tatsächlich smarter macht.","highlights":{"0":"KI-Tool Beratung","1":"Praktische Integration","2":"Echter Mehrwert"}}},"cta":{"titlePart1":"Welche Marke","titlePart2":"passt zu Ihnen?","description":"Lassen Sie uns gemeinsam herausfinden, wie wir Ihren Vertrieb auf das nächste Level bringen können.","button":"Jetzt Kontakt aufnehmen"},"learnMore":"Mehr erfahren"},"privacy":{"title":"Datenschutzerklärung","subtitle":"Informationen zur Verarbeitung Ihrer Daten gemäß DSGVO","tableOfContents":"Inhaltsverzeichnis","sections":{"overview":{"title":"Datenschutz auf einen Blick","content":"Die folgenden Hinweise geben einen einfachen Überblick darüber, was mit Ihren personenbezogenen Daten passiert, wenn Sie diese Website besuchen. Personenbezogene Daten sind alle Daten, mit denen Sie persönlich identifiziert werden können."},"general":{"title":"Allgemeine Hinweise","content1":"Die Betreiber dieser Seiten nehmen den Schutz Ihrer persönlichen Daten sehr ernst. Wir behandeln Ihre personenbezogenen Daten vertraulich und entsprechend der gesetzlichen Datenschutzbestimmungen sowie dieser Datenschutzerklärung.","content2":"Wenn Sie diese Website benutzen, werden verschiedene personenbezogene Daten erhoben. Diese Datenschutzerklärung erläutert, welche Daten wir erheben und wofür wir sie nutzen."},"responsible":{"title":"Verantwortliche Stelle","intro":"Verantwortlich für die Datenverarbeitung auf dieser Website ist:"},"collection":{"title":"Datenerfassung","subtitle":"Welche Daten erfassen wir?","intro":"Beim Besuch dieser Website speichert der Server automatisch Informationen, die Ihr Browser übermittelt. Dies sind:","items":{"ip":"IP-Adresse","browser":"Browsertyp und Browserversion","os":"Verwendetes Betriebssystem","datetime":"Datum und Uhrzeit des Zugriffs","referrer":"Websites, von denen das System des Nutzers auf unsere Website gelangt"},"footer":"Diese Daten werden ausschließlich zur Sicherstellung des Betriebs und zur Verbesserung des Angebots genutzt. Eine Zusammenführung mit anderen Datenquellen wird nicht vorgenommen."},"contact":{"title":"Kontaktformular","content1":"Wenn Sie uns per E-Mail oder Kontaktformular Anfragen zukommen lassen, werden Ihre Angaben aus dem Anfrageformular inklusive der von Ihnen dort angegebenen Kontaktdaten zwecks Bearbeitung der Anfrage und für den Fall von Anschlussfragen bei uns gespeichert.","content2":"Diese Daten geben wir nicht ohne Ihre Einwilligung weiter. Die Verarbeitung erfolgt auf Grundlage von Art. 6 Abs. 1 lit. b DSGVO, sofern Ihre Anfrage mit der Erfüllung eines Vertrags zusammenhängt oder zur Durchführung vorvertraglicher Maßnahmen erforderlich ist."},"rights":{"title":"Ihre Rechte","intro":"Sie haben jederzeit das Recht auf unentgeltliche Auskunft über Ihre gespeicherten personenbezogenen Daten, deren Herkunft und Empfänger und den Zweck der Datenverarbeitung sowie ein Recht auf Berichtigung oder Löschung dieser Daten.","subtitle":"Ihre Rechte im Überblick:","items":{"access":{"title":"Auskunftsrecht:","description":"Sie können Auskunft über Ihre gespeicherten Daten verlangen"},"rectification":{"title":"Berichtigungsrecht:","description":"Sie können die Berichtigung unrichtiger Daten verlangen"},"deletion":{"title":"Löschungsrecht:","description":"Sie können die Löschung Ihrer Daten verlangen"},"restriction":{"title":"Einschränkung der Verarbeitung:","description":"Sie können die Einschränkung der Verarbeitung verlangen"},"objection":{"title":"Widerspruchsrecht:","description":"Sie können der Verarbeitung widersprechen"},"portability":{"title":"Datenübertragbarkeit:","description":"Sie können Ihre Daten in einem strukturierten Format erhalten"}},"footer":"Hierzu sowie zu weiteren Fragen zum Thema personenbezogene Daten können Sie sich jederzeit unter der im Impressum angegebenen Adresse an uns wenden."}}},"imprint":{"title":"Impressum","sections":{"company":{"title":"Angaben gemäß § 5 TMG","country":"Deutschland"},"contact":{"title":"Kontakt","email":"E-Mail:","phone":"Telefon:","phonePlaceholder":"[folgt]"},"taxId":{"title":"Umsatzsteuer-ID","content":"Umsatzsteuer-ID gemäß § 27 a Umsatzsteuergesetz: [folgt]"},"register":{"title":"Registereintrag","intro":"Eintragung im Handelsregister.","court":"Registergericht:","number":"Registernummer:"},"responsible":{"title":"Verantwortlich für den Inhalt nach § 55 Abs. 2 RStV:"}}},"email":{"greeting":"Hallo {firstName} {lastName},","bodyIntro":"vielen Dank für Ihre Nachricht. Dies ist eine Kopie der Anfrage, die wir soeben erhalten haben.","bodyOutro":"Wir prüfen Ihr Anliegen und werden uns schnellstmöglich – in der Regel innerhalb der nächsten 24 Stunden – bei Ihnen melden.","yourMessage":"Ihre Nachricht:","poweredBy":"Powered by","rightsReserved":"Alle Rechte vorbehalten.","subject":"Betreff","topic":"Thema","confirmationTitle":"Wir haben Ihre Anfrage erhalten","confirmationBody":"Vielen Dank für Ihre Nachricht. Wir haben Ihr Anliegen erfasst und werden uns so schnell wie möglich bei Ihnen melden.","submissionType":"Anfragetyp","contactEmail":"E-Mail","contactPhone":"Telefon","company":"Unternehmen","typeMessage":"Nachricht","typeCallback":"Rückruf","typeOther":"Sonstiges"},"auth":{"badge":"Sicherer Zugang","menuLabel":"Konto","guest":"Gast","providerHint":"Fahre mit Google oder erstelle dein Konto per E-Mail.","signInPageCta":"Anmeldeseite öffnen","signUpPageCta":"Registrierungsseite öffnen","signIn":"Anmelden","signUp":"Konto erstellen","signedIn":"Mit Clerk angemeldet","accountCta":"Konto verwalten","signOut":"Abmelden","signInTitle":"Willkommen zurück bei der Advantis Group","signInSubtitle":"Melde dich mit Clerk an, um dein Profil, deine Sicherheitseinstellungen und künftige geschützte Bereiche zentral zu verwalten.","signUpTitle":"Erstelle dein Advantis-Konto","signUpSubtitle":"Nutze Clerk für ein sicheres Konto und verwalte Profil, Anmeldemethoden und künftige Mitgliederbereiche an einem Ort.","accountBadge":"Kontozentrale","accountTitle":"Dein Konto","accountSubtitle":"Verwalte dein Profil, deine Sicherheitseinstellungen und aktive Sitzungen im gehosteten Account Center von Clerk.","signInRequired":"Bitte melde dich zuerst an, um deine Kontoeinstellungen aufzurufen.","submissionsCta":"Anfragen ansehen","contactCta":"Neue Anfrage senden","subm