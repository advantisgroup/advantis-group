{
  "name": "advantis",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "type-check": "turbo run type-check",
    "format": "turbo run format",
    "format:check": "turbo run format:check",
    "dev:intranet": "turbo run dev --filter=@advantis/intranet",
    "build:intranet": "turbo run build --filter=@advantis/intranet",
    "lint:intranet": "turbo run lint --filter=@advantis/intranet",
    "type-check:intranet": "turbo run type-check --filter=@advantis/intranet",
    "format:intranet": "turbo run format --filter=@advantis/intranet",
    "dev:marketing": "turbo run dev --filter=@advantis/marketing",
    "build:marketing": "turbo run build --filter=@advantis/marketing",
    "lint:marketing": "turbo run lint --filter=@advantis/marketing",
    "type-check:marketing": "turbo run type-check --filter=@advantis/marketing",
    "format:marketing": "turbo run format --filter=@advantis/marketing",
    "dev:api": "turbo run dev --filter=@advantis/api",
    "build:api": "turbo run build --filter=@advantis/api",
    "lint:api": "turbo run lint --filter=@advantis/api",
    "type-check:api": "turbo run type-check --filter=@advantis/api",
    "dev:convex": "turbo run dev --filter=@advantis/convex",
    "lint:convex": "turbo run lint --filter=@advantis/convex",
    "type-check:convex": "turbo run type-check --filter=@advantis/convex",
    "convex:dev": "turbo run dev --filter=@advantis/convex",
    "convex:deploy": "turbo run convex:deploy --filter=@advantis/convex",
    "setup-env": "bun scripts/setup-env.mjs",
    "updates:publish": "bun run scripts/publish-update.ts"
  },
  "dependencies": {
    "@types/node": "^26.1.2",
    "oxlint": "^1.76.0",
    "oxlint-tsgolint": "^7.0.2001"
  },
  "devDependencies": {
    "@advantis/convex": "workspace:*",
    "gray-matter": "^4.0.3",
    "oxfmt": "^0.61.0",
    "prettier": "^3.9.6",
    "turbo": "^2.10.7",
    "typescript": "^7.0.2"
  },
  "//overrides": "Keep vaul on the same @radix-ui/react-dialog the apps use. A second copy nests its own @radix-ui/react-dismissable-layer, and that module tracks the body's original `pointer-events` in a module-level variable — two instances then disagree about what to restore and can leave the page permanently dead to clicks. See docs/radix-vaul-dedupe.md.",
  "overrides": {
    "@radix-ui/react-dialog": "^1.1.23"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "bun@1.3.14",
  "trustedDependencies": [
    "@parcel/watcher",
    "@swc/core",
    "@tsparticles/engine",
    "core-js",
    "esbuild",
    "protobufjs",
    "unrs-resolver"
  ]
}
